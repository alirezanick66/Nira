		"باتری ضعیف": { "battery_quality": "poor" },
		"باتری قوی": { "battery_quality": "excellent" },
		"باتری بزرگ": { "battery_quality": "excellent" },
		"باتری خوب": { "battery_quality": "good" },
		"دوربین خوب": { "camera_quality": "good" },
		"دوربین قوی": { "camera_quality": "excellent" },
		"دوربین عالی": { "camera_quality": "excellent" },
		"دوربین حرفه‌ای": { "camera_quality": "excellent" },

		"ارزش خرید بالا": { "value_for_money": "excellent" },
		"به‌صرفه": { "value_for_money": "good" }
	},
	"use_case_rules": {
		"گیمینگ": { "ram_gb": { "gte": 8 }, "tags": ["gaming"] },
		"گیم": { "ram_gb": { "gte": 8 }, "tags": ["gaming"] },
		"بازی": { "ram_gb": { "gte": 8 }, "tags": ["gaming"] },
		"عکاسی": { "camera_quality": "excellent", "tags": ["photography"] },
		"عکس": { "camera_quality": "good", "tags": ["photography"] },
		"فیلمبرداری": {
			"camera_quality": "excellent",
			"tags": ["photography"]
		},
		"دانشجویی": { "price_range": "budget" },
		"حرفه‌ای": { "price_range": "premium" },
		"سبک": { "tags": ["lightweight"] }
	},
	"intent_keywords": {
		"greeting": [
			"سلام",
			"درود",
			"صبح بخیر",
			"شب بخیر",
			"خوبی",
			"وقت بخیر",
			"چطوری",
			"خداحافظ"
		],
		"compare": [
			"مقایسه",
			"فرق",
			"تفاوت",
			"کدوم بهتره",
			"کدوم بهتر",
			"بین",
			"در برابر",
			"vs"
		],
		"refine": [
			"ارزونتر",
			"ارزون‌تر",
			"گرونتر",
			"گرون‌تر",
			"دیگه",
			"بعدی",
			"یه چیز دیگه",
			"گزینه دیگه",
			"سبک‌تر",
			"سبکتر",
			"قوی‌تر",
			"قویتر"
		]
	},
	"slot_definitions": [
		{
			"name": "price",
			"type": "range",
			"units": {
				"میلیارد": 1000000000,
				"میلیون": 1000000,
				"هزار": 1000,
				"تومان": 1,
				"تومن": 1,
				"ت": 1
			},
			"operators": {
				"زیر": "<=",
				"بالای": ">=",
				"حدود": "approx",
				"تا": "<=",
				"کمتر": "<="
			},
			"regex_template": "(?P<op>زیر|بالای|حدود|کمتر|تا|بیشتر|حداقل)?\\s*(?P<num>\\d+(?:\\.\\d+)?|صفر|یک|یه|دو|سه|چهار|پنج|شش|هفت|هشت|نه|ده|یازده|دوازده|سیزده|چهارده|پانزده|شانزده|هفده|هجده|نوزده|بیست|سی|چهل|پنجاه|شصت|هفتاد|هشتاد|نود|صد|دویست|سیصد|چهارصد|پانصد|ششصد|هفتصد|هشتصد|نهصد|هزار|میلیون|میلیارد(?:\\s+و\\s+(?:...))?)\\s*(?P<unit>میلیارد|میلیون|هزار|تومان|تومن|ت)?",
			"mask_cues": ["قیمت", "بودجه", "ارزان", "گران", "گوشی"]
		},
		{
			"name": "ram_gb",
			"type": "scalar",
			"units": { "گیگابایت": 1, "گیگ": 1, "gb": 1 },
			"operators": { "حداقل": ">=", "بالای": ">=", "زیر": "<=" },
			"regex_template": "(?P<op>حداقل|بالای|زیر|بیشتر|حدود)?\\s*(?P<num>\\d{1,2})\\s*(?P<unit>گیگ(?:ابایت)?|gb)?\\s*(?:رم|ram)?",
			"mask_cues": ["رم", "ram"]
		},
		{
			"name": "storage_gb",
			"type": "scalar",
			"units": {
				"گیگابایت": 1,
				"گیگ": 1,
				"gb": 1,
				"ترابایت": 1024,
				"tb": 1024
			},
			"operators": { "حداقل": ">=", "بالای": ">=" },
			"regex_template": "(?P<num>\\d{2,4})\\s*(?P<unit>گیگ(?:ابایت)?|gb|ترابایت|tb)?\\s*(?:حافظه|فضا|هارد|storage)?",
			"mask_cues": ["حافظه", "فضا", "هارد", "storage"]
		}
	]
}
