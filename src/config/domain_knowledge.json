		"ارزان‌تر": { "price_range": "budget" },
		"ارزون": { "price_range": "budget" },
		"ارزون‌تر": { "price_range": "budget" },
		"اقتصادی": { "price_range": "budget" },
		"بودجه": { "price_range": "budget" },

		"متوسط": { "price_range": "mid" },
		"قیمت مناسب": { "price_range": "mid" },
		"میان‌رده": { "price_range": "mid" },
